      "targets": [
        {
          "expr": "100 * sum(max by (cluster, node) (slurm_node_allocated_memory_bytes{cluster=~\"$cluster\"})) / clamp_min(sum(max by (cluster, node) (slurm_node_memory_bytes{cluster=~\"$cluster\"})), 1)",
          "instant": false,
          "legendFormat": "Memory",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Memory Utilization",
      "type": "gauge"
