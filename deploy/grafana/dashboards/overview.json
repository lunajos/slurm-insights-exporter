{
  "annotations": {
    "list": []
  },
  "description": "Generated for slurm-insights-exporter metrics.",
  "id": null,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "All collectors succeeded on the latest snapshot.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "min(slurm_exporter_up)",
          "instant": false,
          "legendFormat": "Exporter",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Exporter Up",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Allocated CPUs as a percentage of configured CPUs, deduplicated for nodes in multiple partitions.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "100 * sum(max by (cluster, node) (slurm_node_cpu_count{cluster=~\"$cluster\",status=\"allocated\"})) / clamp_min(sum(max by (cluster, node) (slurm_node_cpu_count{cluster=~\"$cluster\",status=\"total\"})), 1)",
          "instant": false,
          "legendFormat": "CPU",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "CPU Utilization",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Slurm allocated memory divided by configured memory, deduplicated by node.",
