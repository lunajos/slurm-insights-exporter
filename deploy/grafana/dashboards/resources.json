{
  "annotations": {
    "list": []
  },
  "description": "Generated for slurm-insights-exporter metrics.",
  "id": null,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Reservation inventory.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "slurm_reservation_info{cluster=~\"$cluster\"}",
          "instant": true,
          "legendFormat": "{{reservation}} {{partition}} {{state}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Reservations",
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Node allocation by reservation.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "slurm_reservation_nodes{cluster=~\"$cluster\"}",
          "instant": false,
          "legendFormat": "{{reservation}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Reserved Nodes",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Core allocation by reservation.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "slurm_reservation_cores{cluster=~\"$cluster\"}",
          "instant": false,
          "legendFormat": "{{reservation}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Reserved Cores",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Reservation expiry.",
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "slurm_reservation_end_time_seconds{cluster=~\"$cluster\"} * 1000",
          "instant": true,
          "legendFormat": "{{reservation}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Reservation End",
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Total, used, free, and reserved license counts.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "slurm_license_count{cluster=~\"$cluster\"}",
          "instant": false,
          "legendFormat": "{{license}} / {{status}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Licenses",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Current license saturation.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "id": 6,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "100 * sum by (license) (slurm_license_count{cluster=~\"$cluster\",status=\"used\"}) / clamp_min(sum by (license) (slurm_license_count{cluster=~\"$cluster\",status=\"total\"}), 1)",
          "instant": false,
          "legendFormat": "{{license}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "License Utilization",
      "type": "bargauge"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "slurm",
    "hpc",
    "slurm-insights-exporter"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "label": "Datasource",
        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "includeAll": true,
        "label": "Cluster",
        "multi": true,
        "name": "cluster",
        "query": "label_values(slurm_node_info, cluster)",
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "includeAll": true,
        "label": "Partition",
        "multi": true,
        "name": "partition",
        "query": "label_values(slurm_node_info{cluster=~\"$cluster\"}, partition)",
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "includeAll": true,
        "label": "Account",
        "multi": true,
        "name": "account",
        "query": "label_values(slurm_queue_jobs{cluster=~\"$cluster\"}, account)",
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "includeAll": true,
        "label": "QoS",
        "multi": true,
        "name": "qos",
        "query": "label_values(slurm_queue_jobs{cluster=~\"$cluster\"}, qos)",
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "includeAll": true,
        "label": "Node",
        "multi": true,
        "name": "node",
        "query": "label_values(slurm_node_info{cluster=~\"$cluster\",partition=~\"$partition\"}, node)",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
