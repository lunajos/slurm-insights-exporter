        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "includeAll": true,
        "label": "Cluster",
        "multi": true,
        "name": "cluster",
        "query": "label_values(slurm_node_info, cluster)",
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "includeAll": true,
        "label": "Partition",
        "multi": true,
        "name": "partition",
        "query": "label_values(slurm_node_info{cluster=~\"$cluster\"}, partition)",
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "includeAll": true,
        "label": "Account",
        "multi": true,
        "name": "account",
        "query": "label_values(slurm_queue_jobs{cluster=~\"$cluster\"}, account)",
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "includeAll": true,
        "label": "QoS",
        "multi": true,
        "name": "qos",
        "query": "label_values(slurm_queue_jobs{cluster=~\"$cluster\"}, qos)",
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "includeAll": true,
        "label": "Node",
        "multi": true,
        "name": "node",
        "query": "label_values(slurm_node_info{cluster=~\"$cluster\",partition=~\"$partition\"}, node)",
