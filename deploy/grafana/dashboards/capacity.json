          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (partition) (slurm_partition_nodes{cluster=~\"$cluster\",partition=~\"$partition\"})",
