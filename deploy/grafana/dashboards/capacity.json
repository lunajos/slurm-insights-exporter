        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "slurm_node_profile_assignment{cluster=~\"$cluster\",partitions=~\".*$partition.*\",node=~\"$node\"}",
          "instant": false,
          "legendFormat": "{{node}} / {{state}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Node Status Timeline",
      "type": "state-timeline"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Expected node shape inferred from normalized Slurm CfgTRES.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "id": 9,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "slurm_node_profile_assignment{cluster=~\"$cluster\",profile=~\"$profile\",node=~\"$node\"}",
          "instant": true,
          "legendFormat": "{{node}} / {{profile}} / {{state}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Node Profile Membership",
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Highlights unusual or singleton node profiles and unhealthy states.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 16
      },
      "id": 10,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum by (profile, state) (slurm_node_profile_nodes{cluster=~\"$cluster\",profile=~\"$profile\"})",
          "instant": false,
          "legendFormat": "{{profile}} / {{state}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Profile Population by State",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Expected per-node resources derived from CfgTRES. Memory values are bytes.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "id": 11,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "slurm_node_profile_tres{cluster=~\"$cluster\",profile=~\"$profile\",resource=~\"$resource\"}",
          "instant": true,
          "legendFormat": "{{profile}} / {{resource}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Expected TRES per Profile",
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "slurm",
    "hpc",
    "slurm-insights-exporter"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "label": "Datasource",
        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "includeAll": true,
        "label": "Cluster",
        "multi": true,
        "name": "cluster",
        "query": "label_values(slurm_node_info, cluster)",
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "includeAll": true,
        "label": "Partition",
        "multi": true,
        "name": "partition",
        "query": "label_values(slurm_node_info{cluster=~\"$cluster\"}, partition)",
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "includeAll": true,
        "label": "Account",
        "multi": true,
        "name": "account",
        "query": "label_values(slurm_queue_jobs{cluster=~\"$cluster\"}, account)",
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "includeAll": true,
        "label": "QoS",
        "multi": true,
        "name": "qos",
        "query": "label_values(slurm_queue_jobs{cluster=~\"$cluster\"}, qos)",
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "includeAll": true,
        "label": "Node",
        "multi": true,
        "name": "node",
        "query": "label_values(slurm_node_info{cluster=~\"$cluster\",partition=~\"$partition\"}, node)",
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "includeAll": true,
        "label": "TRES",
        "multi": true,
        "name": "resource",
        "query": "label_values(slurm_cluster_tres{cluster=~\"$cluster\"}, resource)",
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "includeAll": true,
        "label": "Node Profile",
        "multi": true,
        "name": "profile",
        "query": "label_values(slurm_node_profile_info{cluster=~\"$cluster\"}, profile)",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
