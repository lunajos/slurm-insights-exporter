    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Configured partition time limits.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "id": 7,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "max by (partition) (slurm_partition_time_limit_seconds{cluster=~\"$cluster\",partition=~\"$partition\"})",
          "instant": true,
          "legendFormat": "{{partition}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Partition Time Limits",
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Node state and profile assignment over time.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "id": 8,
      "options": {
        "legend": {
          "displayMode": "table",
